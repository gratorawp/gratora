{
  "name": "dono",
  "version": "1.0.0",
  "description": "Most advanced donation platform for WordPress",
  "private": true,
  "scripts": {
    "build": "wp-scripts build && npm run copy:vendor-css",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "format": "wp-scripts format",
    "test:e2e": "playwright test",
    "test:visual": "DONO_E2E_VISUAL=1 playwright test --project=visual",
    "test:visual:update": "DONO_E2E_VISUAL=1 playwright test --project=visual --update-snapshots",
    "db:reset": "php bin/reseed.php",
    "db:seed-demo": "php -d memory_limit=512M bin/seed-demo.php",
    "copy:vendor-css": "mkdir -p build/admin/campaigns build/admin/donations build/admin/donors build/admin/forms build/admin/funds && cp node_modules/@wordpress/dataviews/build-style/style.css build/admin/campaigns/dataviews.css && cp node_modules/@wordpress/dataviews/build-style/style.css build/admin/donations/dataviews.css && cp node_modules/@wordpress/dataviews/build-style/style.css build/admin/donors/dataviews.css && cp node_modules/@wordpress/dataviews/build-style/style.css build/admin/forms/dataviews.css && cp node_modules/@wordpress/dataviews/build-style/style.css build/admin/funds/dataviews.css",
    "package": "node bin/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@wordpress/env": "^11.6.0",
    "@wordpress/scripts": "^30.0.0",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dono/ui": "github:getdono/ui#v0.1.10",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^13.0.0",
    "@wordpress/commands": "^1.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/core-data": "^7.45.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/dataviews": "^4.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "@wordpress/interface": "^9.0.0",
    "@wordpress/keyboard-shortcuts": "^5.0.0",
    "@wordpress/keycodes": "^4.0.0",
    "@wordpress/notices": "^5.0.0",
    "@wordpress/url": "^4.0.0",
    "lucide-react": "^1.16.0",
    "preact": "^10.29.1",
    "recharts": "^3.8.1"
  },
  "overrides": {
    "schema-utils@^4": {
      "ajv": "^8.17.1",
      "ajv-keywords": "^5.1.0"
    }
  }
}

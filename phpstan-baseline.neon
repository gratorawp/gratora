parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access on non\-nullable type FundKit\\Forms\\Form\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Campaigns/Blocks/DonateButtonBlock.php

		-
			message: '#^Offset ''avatar_url'' on array\{name\: string, amount_cents\: int, donations_count\: int, is_anonymous\: bool\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Campaigns/Blocks/views/top-donors.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Campaigns/CampaignService.php

		-
			message: '#^Method FundKit\\Campaigns\\Styling\\Tokens\:\:catalogue\(\) should return array\<string, array\{group\: string, label\: string, default\: string, control\: string, min\?\: float\|int, max\?\: float\|int, step\?\: float\|int, options\?\: array\<string, string\>, \.\.\.\}\> but returns array\{fundkit\-accent\: array\{group\: ''brand'', label\: string, default\: ''\#211d3f'', control\: ''color''\}, fundkit\-accent\-soft\: array\{group\: ''brand'', label\: string, default\: ''\#efedf8'', control\: ''color'', help\: string\}, fundkit\-text\: array\{group\: ''brand'', label\: string, default\: ''\#111827'', control\: ''color''\}, fundkit\-text\-muted\: array\{group\: ''brand'', label\: string, default\: ''\#6b7280'', control\: ''color'', help\: string\}, fundkit\-bg\: array\{group\: ''surface'', label\: string, default\: ''\#ffffff'', control\: ''color''\}, fundkit\-bg\-soft\: array\{group\: ''surface'', label\: string, default\: ''\#f8fafb'', control\: ''color'', help\: string\}, fundkit\-border\: array\{group\: ''surface'', label\: string, default\: ''\#e5e7eb'', control\: ''color''\}, fundkit\-typeface\: array\{group\: ''typography'', label\: string, default\: ''system\-ui, \-apple…'', control\: ''font''\}, \.\.\.\}\.$#'
			identifier: return.type
			count: 1
			path: src/Campaigns/Styling/Tokens.php

		-
			message: '#^Anonymous function has an unused use \$c\.$#'
			identifier: closure.unusedUse
			count: 1
			path: src/Core/CoreModule.php

		-
			message: '#^Comparison operation "\<\=" between int\<min, 90\>\|int\<181, 365\> and 365 is always true\.$#'
			identifier: smallerOrEqual.alwaysTrue
			count: 1
			path: src/Donors/DonorMetricsService.php

		-
			message: '#^Method FundKit\\Donors\\DonorMetricsService\:\:noteForEvent\(\) never returns string so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Donors/DonorMetricsService.php

		-
			message: '#^Parameter \#2 \$noteMap of method FundKit\\Donors\\DonorMetricsService\:\:noteForEvent\(\) expects array\<int, string\>, array\<int, array\<string, string\|null\>\> given\.$#'
			identifier: argument.type
			count: 2
			path: src/Donors/DonorMetricsService.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Donors/DonorService.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$donations_count \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Forms/Blocks/GoalBlock.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$donors_count \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 2
			path: src/Forms/Blocks/GoalBlock.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$raised_cents \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Forms/Blocks/GoalBlock.php

		-
			message: '#^Method FundKit\\Forms\\Blocks\\NumberInputBlock\:\:attributes\(\) should return array\<string, array\{type\: string, default\?\: mixed\}\> but returns array\{label\: array\{type\: ''string'', default\: ''''\}, placeholder\: array\{type\: ''string'', default\: ''''\}, helpText\: array\{type\: ''string'', default\: ''''\}, required\: array\{type\: ''boolean'', default\: false\}, min\: array\{type\: array\{''number'', ''null''\}, default\: null\}, max\: array\{type\: array\{''number'', ''null''\}, default\: null\}, step\: array\{type\: ''number'', default\: 1\}, field\: array\{type\: ''string'', default\: ''''\}\}\.$#'
			identifier: return.type
			count: 1
			path: src/Forms/Blocks/NumberInputBlock.php

		-
			message: '#^Offset ''id'' on array\{id\: string, label\: string, description\: string, currencies\: list\<string\>, countries\: list\<string\>, frequencies\: list\<string\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Forms/Blocks/PaymentGatewaysBlock.php

		-
			message: '#^Using nullsafe property access "\?\-\>default_form_id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Forms/FormService.php

		-
			message: '#^Property FundKit\\Forms\\Form\:\:\$blocks \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Forms/FormSubmissionValidator.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Forms/FormSubmissionValidator.php

		-
			message: '#^Comparison operation "\>" between 0 and 0 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 2
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Method FundKit\\Forms\\Shortcode\\DonationFormShortcode\:\:hasPaymentGatewaysBlock\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Offset ''page'' on array\{type\: ''amount'', page\: 0, presets\: list\<mixed\>, allowCustom\: bool\}\|array\{type\: ''submit'', page\: 0, label\: mixed, align\?\: ''center''\|''full''\|''left''\|''right''\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Offset ''page'' on array\{type\: ''amount'', page\: 0, presets\: list\<mixed\>, allowCustom\: bool\}\|array\{type\: ''submit'', page\: 0, label\: string, align\: ''center''\|''full''\|''left''\|''right''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Offset ''t'' on \*NEVER\* on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\<string\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Strict comparison using \=\=\= between 0 and 1 will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Variable \$items in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Variable \$stepDefs in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/Forms/Shortcode/DonationFormShortcode.php

		-
			message: '#^Template type T of method FundKit\\Foundation\\Container\\Container\:\:get\(\) is not referenced in a parameter\.$#'
			identifier: method.templateTypeNotInParameter
			count: 1
			path: src/Foundation/Container/Container.php

		-
			message: '#^Strict comparison using \=\=\= between non\-empty\-list\<string\|null\> and array\{\} will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Foundation/Transfer/CsvImporter.php

		-
			message: '#^Method FundKit\\Foundation\\Transfer\\DataImporter\:\:drop\(\) never returns array\<string, mixed\> so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Foundation/Transfer/DataImporter.php

		-
			message: '#^Offset ''default_form_id''\|''household_id''\|''parent_fund_id'' on array\{donor_id\: ''fundkit_donors'', household_id\: ''fundkit_donors'', campaign_id\: ''fundkit_campaigns'', form_id\: ''fundkit_forms'', source_form_id\: ''fundkit_forms'', default_form_id\: ''fundkit_forms'', fund_id\: ''fundkit_funds'', default_fund_id\: ''fundkit_funds'', \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Foundation/Transfer/DataImporter.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: src/Foundation/Transfer/DataImporter.php

		-
			message: '#^Property FundKit\\Donations\\Donation\:\:\$kind \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Receipts/ReceiptIssuer.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$raised_cents \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Admin/CampaignsController.php

		-
			message: '#^Using nullsafe property access "\?\-\>status" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Rest/Admin/DonationsController.php

		-
			message: '#^Method FundKit\\Rest\\Admin\\DonorsController\:\:index\(\) never returns WP_Error so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Rest/Admin/DonorsController.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Rest/Admin/FormsController.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$donations_count \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Admin/FormsController.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$donors_count \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Admin/FormsController.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$goal_type \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Admin/FormsController.php

		-
			message: '#^Property FundKit\\Campaigns\\Campaign\:\:\$raised_cents \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Admin/FormsController.php

		-
			message: '#^Method FundKit\\Rest\\Admin\\OnboardingController\:\:finalize\(\) never returns WP_Error so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Rest/Admin/OnboardingController.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(FundKit\\Vendor\\Queryable\\Model\)\: mixed\)\|null, Closure\(FundKit\\Donations\\Donation\)\: array\{reference\: string, amount_cents\: int, currency\: string, frequency\: string, is_test\: bool, failure_recorded\: bool\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Rest/Admin/RecurringController.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Rest/Admin/StripeKeysController.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: src/Rest/DonationsController.php

		-
			message: '#^Property FundKit\\Forms\\Form\:\:\$blocks \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 2
			path: src/Rest/DonationsController.php

		-
			message: '#^Using nullsafe property access "\?\-\>status" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Rest/PayPalController.php

		-
			message: '#^Property FundKit\\Donors\\Consent\:\:\$purpose_version \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Rest/Portal/PortalController.php

		-
			message: '#^Using nullsafe property access "\?\-\>flags" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Rest/Portal/PortalController.php

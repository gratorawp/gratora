parameters:
	ignoreErrors:
		-
			message: '#^Property GiveFlow\\Admin\\Pages\\SettingsPage\:\:\$container is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Admin/Pages/SettingsPage.php

		-
			message: '#^Using nullsafe property access on non\-nullable type GiveFlow\\Forms\\Form\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Campaigns/Blocks/DonateButtonBlock.php

		-
			message: '#^Property GiveFlow\\Campaigns\\Blocks\\SupporterWallBlock\:\:\$donations is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Campaigns/Blocks/SupporterWallBlock.php

		-
			message: '#^Variable \$emptyText might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Campaigns/Blocks/views/donation-form.php

		-
			message: '#^Offset ''avatar_url'' on array\{name\: string, amount_cents\: int, donations_count\: int, is_anonymous\: bool\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Campaigns/Blocks/views/top-donors.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'

			count: 1
			path: src/Campaigns/CampaignService.php

		-
			message: '#^Method GiveFlow\\Campaigns\\Styling\\Tokens\:\:catalogue\(\) should return array\<string, array\{group\: string, label\: string, default\: string, control\: string, min\?\: float\|int, max\?\: float\|int, step\?\: float\|int, options\?\: array\<string, string\>, \.\.\.\}\> but returns array\{giveflow\-accent\: array\{group\: ''brand'', label\: string, default\: ''\#211d3f'', control\: ''color''\}, giveflow\-accent\-soft\: array\{group\: ''brand'', label\: string, default\: ''\#efedf8'', control\: ''color'', help\: string\}, giveflow\-text\: array\{group\: ''brand'', label\: string, default\: ''\#111827'', control\: ''color''\}, giveflow\-text\-muted\: array\{group\: ''brand'', label\: string, default\: ''\#6b7280'', control\: ''color'', help\: string\}, giveflow\-bg\: array\{group\: ''surface'', label\: string, default\: ''\#ffffff'', control\: ''color''\}, giveflow\-bg\-soft\: array\{group\: ''surface'', label\: string, default\: ''\#f8fafb'', control\: ''color'', help\: string\}, giveflow\-border\: array\{group\: ''surface'', label\: string, default\: ''\#e5e7eb'', control\: ''color''\}, giveflow\-typeface\: array\{group\: ''typography'', label\: string, default\: ''system\-ui, \-apple…'', control\: ''font''\}, \.\.\.\}\.$#'
			identifier: return.type
			count: 1
			path: src/Campaigns/Styling/Tokens.php

		-
			message: '#^Anonymous function has an unused use \$c\.$#'
			identifier: closure.unusedUse
			count: 1
			path: src/Core/CoreModule.php

		-
			message: '#^Method GiveFlow\\Currency\\FxRates\:\:fetchedAt\(\) never returns string so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Currency/FxRates.php

		-
			message: '#^Offset ''fetched_at'' does not exist on array\{base\: string, date\: string, rates\: array\<string, mixed\>, manual\?\: array\<string, mixed\>, auto\?\: bool\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Currency/FxRates.php

		-
			message: '#^Comparison operation "\<\=" between int\<min, 90\>\|int\<181, 365\> and 365 is always true\.$#'

msgstr "Verificado"

#: assets/admin/settings/panels/StripeKeysCard.jsx:210
#: assets/admin/tools/tabs/LogsTab.jsx:41
msgid "Not verified"
msgstr "No verificado"

#: assets/admin/settings/panels/StripeKeysCard.jsx:218
msgid "Apple Pay"
msgstr "Apple Pay"

#: assets/admin/settings/panels/StripeKeysCard.jsx:223
msgid "Google Pay needs nothing here, it appears as soon as your Stripe account supports it. Apple checks that you own this domain first, and until it verifies, the Apple Pay button just never shows."
msgstr "Google Pay no necesita nada aquí: aparece en cuanto tu cuenta de Stripe lo admite. Apple comprueba primero que este dominio es tuyo y, hasta que lo verifica, el botón de Apple Pay simplemente no aparece."

#: assets/admin/settings/panels/StripeKeysCard.jsx:226
msgid "Domain"
msgstr "Dominio"

#: assets/admin/settings/panels/StripeKeysCard.jsx:234
msgid "Domain association file"
msgstr "Archivo de asociación de dominio"

#: assets/admin/settings/panels/StripeKeysCard.jsx:235
msgid "In Stripe, go to Settings, Payment method domains, and add the domain above. Stripe links a file to download, paste its whole contents here."
msgstr "En Stripe, ve a Configuración, Dominios de métodos de pago, y añade el dominio de arriba. Stripe enlaza un archivo para descargar; pega aquí todo su contenido."

#: assets/admin/settings/panels/StripeKeysCard.jsx:248
msgid "Enable Apple Pay"
msgstr "Activar Apple Pay"

#: assets/admin/settings/panels/StripeKeysCard.jsx:263
msgid "Live"

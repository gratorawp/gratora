msgid_plural "%d add-ons are licensed"
msgstr[0] "%d extensión tiene licencia"
msgstr[1] "%d extensiones tienen licencia"

#: src/Settings/SettingsService.php:272
msgid "Thank you for your donation to {organisation_name}"
msgstr "Gracias por tu donación a {organisation_name}"

#: src/Settings/SettingsService.php:273
msgid "Hi {donor_first_name},\n\nThank you for your donation of {amount} to {organisation_name}.\n\nReference: {reference}\nReceipt number: {receipt_number}\n\nYour receipt is attached as a PDF. Keep it for your records.\n\nWith gratitude,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nGracias por tu donación de {amount} a {organisation_name}.\n\nReferencia: {reference}\nNúmero de recibo: {receipt_number}\n\nTu recibo va adjunto en PDF. Consérvalo para tus archivos.\n\nCon gratitud,\n{organisation_name}"

#: src/Settings/SettingsService.php:277
msgid "Thank you for your first donation to {organisation_name}"
msgstr "Gracias por tu primera donación a {organisation_name}"

#: src/Settings/SettingsService.php:278
msgid "Hi {donor_first_name},\n\nThank you for making your first donation to {organisation_name}. Your support means a great deal, and we are grateful to have you with us.\n\nWe will keep you posted on the difference it makes.\n\nWith gratitude,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nGracias por hacer tu primera donación a {organisation_name}. Tu apoyo significa muchísimo y agradecemos poder contar contigo.\n\nTe mantendremos al tanto de lo que tu apoyo hace posible.\n\nCon gratitud,\n{organisation_name}"

#: src/Settings/SettingsService.php:282
msgid "Payment instructions for your donation to {organisation_name}"
msgstr "Instrucciones de pago para tu donación a {organisation_name}"

#: src/Settings/SettingsService.php:283
msgid "Hi {donor_name},\n\nThank you for choosing to support {campaign_title} with a donation of {amount}.\n\n{instructions}\n\nPlease transfer the amount using the reference {reference}. We will email your receipt as soon as the payment arrives.\n\n{bank_details}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nGracias por decidir apoyar {campaign_title} con una donación de {amount}.\n\n{instructions}\n\nPor favor, haz la transferencia del importe indicando la referencia {reference}. Te enviaremos el recibo por correo electrónico en cuanto llegue el pago.\n\n{bank_details}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:287
msgid "Your donation is processing"
msgstr "Tu donación se está procesando"

#: src/Settings/SettingsService.php:288
msgid "Hi {donor_first_name},\n\nWe have received your donation of {amount}.\n\nReference: {reference}\n\nYour payment is being processed. Bank settlement can take a few business days; we will email your receipt the moment it clears.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nHemos recibido tu donación de {amount}.\n\nReferencia: {reference}\n\nTu pago se está procesando. La liquidación bancaria puede tardar unos días hábiles; te enviaremos el recibo por correo electrónico en cuanto se complete.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:292
msgid "Your donation has been refunded"
msgstr "Tu donación se ha reembolsado"

#: src/Settings/SettingsService.php:293
msgid "Hi {donor_name},\n\nWe have refunded your donation of {amount} to {campaign_title}. Funds should return to your card within 5 to 10 business days.\n\nIf this was a mistake or you have any questions, just reply to this email.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nHemos reembolsado tu donación de {amount} a {campaign_title}. El dinero debería volver a tu tarjeta en un plazo de 5 a 10 días hábiles.\n\nSi ha sido un error o tienes alguna pregunta, solo tienes que responder a este correo electrónico.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:301
msgid "Payment instructions for {organisation_name}"
msgstr "Instrucciones de pago de {organisation_name}"

#: src/Settings/SettingsService.php:302
msgid "Hi {donor_name},\n\nThank you. Your payment of {amount} is not complete yet.\n\n{instructions}\n\nPlease transfer the amount using the reference {reference}. We will confirm as soon as the payment arrives.\n\n{bank_details}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nGracias. Tu pago de {amount} aún no se ha completado.\n\n{instructions}\n\nPor favor, haz la transferencia del importe indicando la referencia {reference}. Te lo confirmaremos en cuanto llegue el pago.\n\n{bank_details}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:306
msgid "Your payment is processing"
msgstr "Tu pago se está procesando"

#: src/Settings/SettingsService.php:307
msgid "Hi {donor_first_name},\n\nWe have received your payment of {amount}.\n\nReference: {reference}\n\nYour payment is being processed. Bank settlement can take a few business days; we will confirm as soon as it clears.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nHemos recibido tu pago de {amount}.\n\nReferencia: {reference}\n\nTu pago se está procesando. La liquidación bancaria puede tardar unos días hábiles; te lo confirmaremos en cuanto se complete.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:311
msgid "Your payment has been refunded"
msgstr "Tu pago se ha reembolsado"

#: src/Settings/SettingsService.php:312
msgid "Hi {donor_name},\n\nWe have refunded your payment of {amount}. Funds should return to your card within 5 to 10 business days.\n\nReference: {reference}\n\nIf this was a mistake or you have any questions, just reply to this email.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nHemos reembolsado tu pago de {amount}. El dinero debería volver a tu tarjeta en un plazo de 5 a 10 días hábiles.\n\nReferencia: {reference}\n\nSi ha sido un error o tienes alguna pregunta, solo tienes que responder a este correo electrónico.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:316
msgid "Your recurring donation renewed"
msgstr "Tu donación recurrente se ha renovado"

#: src/Settings/SettingsService.php:317
msgid "Hi {donor_name},\n\nYour recurring donation of {amount} to {campaign_title} was renewed today.\n\nReference: {reference}\n\nThank you for your continued support.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se ha renovado hoy.\n\nReferencia: {reference}\n\nTe agradecemos que sigas apoyándonos.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:321
msgid "Your donation couldn't be taken this month"
msgstr "No se ha podido cobrar tu donación este mes"

#: src/Settings/SettingsService.php:322
msgid "Hi {donor_first_name},\n\nWe tried to collect your recurring donation of {amount} to {campaign_title} today and your bank declined it. This usually means a card has expired or been replaced.\n\nNothing has been charged and your donation is still set up. You can put that right here:\n{portal_url}\n\nIf you would rather stop the donation, that is completely fine, and you can do that from the same page.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nHoy hemos intentado cobrar tu donación recurrente de {amount} a {campaign_title} y tu banco la ha rechazado. Normalmente esto significa que la tarjeta ha caducado o se ha sustituido por otra.\n\nNo se te ha cobrado nada y tu donación sigue configurada. Puedes solucionarlo aquí:\n{portal_url}\n\nSi prefieres detener la donación, no hay ningún problema, y puedes hacerlo desde la misma página.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:326
msgid "Your recurring donation has been cancelled"
msgstr "Tu donación recurrente se ha cancelado"

#: src/Settings/SettingsService.php:327
msgid "Hi {donor_name},\n\nYour recurring donation of {amount} to {campaign_title} has been cancelled. No further charges will be made.\n\nThank you for the donations you made along the way.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se ha cancelado. No se realizarán más cobros.\n\nTe agradecemos las donaciones que has hecho durante este tiempo.\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:334
msgid "Your recurring donation amount has changed"
msgstr "El importe de tu donación recurrente ha cambiado"

#: src/Settings/SettingsService.php:335
msgid "Hi {donor_first_name},\n\nYour recurring donation to {campaign_title} has been changed from {old_amount} to {amount}, starting with your next payment.\n\nIf that is not what you expected, you can change it back or stop the donation here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente a {campaign_title} ha pasado de {old_amount} a {amount}, a partir de tu próximo pago.\n\nSi no es lo que esperabas, puedes volver al importe anterior o detener la donación aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:339
msgid "Your recurring donation schedule has changed"
msgstr "La frecuencia de tu donación recurrente ha cambiado"

#: src/Settings/SettingsService.php:340
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} was taken {old_frequency}. It will now be taken {frequency}, starting with the payment after your current one.\n\nIf that is not what you expected, you can change it back or stop the donation here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se cobraba {old_frequency}. A partir de ahora se cobrará {frequency}, empezando por el pago siguiente al actual.\n\nSi no es lo que esperabas, puedes volver a la frecuencia anterior o detener la donación aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:344
msgid "Your recurring donation is paused"
msgstr "Tu donación recurrente está en pausa"

#: src/Settings/SettingsService.php:345
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} has been paused. Nothing will be charged until it restarts on {resumes_at}.\n\nYou can restart it sooner, or stop it altogether, here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se ha puesto en pausa. No se cobrará nada hasta que se reanude el {resumes_at}.\n\nPuedes reanudarla antes, o detenerla del todo, aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:349
msgid "Your recurring donation has restarted"
msgstr "Tu donación recurrente se ha reanudado"

#: src/Settings/SettingsService.php:350
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} has restarted. Your next payment is due on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se ha reanudado. Tu próximo pago está previsto para el {next_payment_at}.\n\nPuedes gestionarla cuando quieras aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:354
msgid "Your next donation has been skipped"
msgstr "Tu próxima donación se ha omitido"

#: src/Settings/SettingsService.php:355
msgid "Hi {donor_first_name},\n\nYour next recurring donation of {amount} to {campaign_title} has been skipped. Nothing will be charged this time, and the donation continues on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu próxima donación recurrente de {amount} a {campaign_title} se ha omitido. Esta vez no se cobrará nada, y la donación continuará el {next_payment_at}.\n\nPuedes gestionarla cuando quieras aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:359
msgid "Your sign-in link for {organisation_name}"
msgstr "Tu enlace de acceso a {organisation_name}"

#: src/Settings/SettingsService.php:360
msgid "Hi {donor_name},\n\nOpen your donor portal:\n{portal_url}\n\nThis link works for {link_expiry} and can only be used once. If you didn't request it, you can ignore this email.\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_name}:\n\nAbre tu portal del donante:\n{portal_url}\n\nEste enlace funciona durante {link_expiry} y solo se puede usar una vez. Si no lo has solicitado, puedes ignorar este correo electrónico.\n\nGracias,\n{organisation_name}"


msgstr "Zu viele abgelehnte Zustellungen. Bitte versuchen Sie es in Kürze erneut."

#: src/Rest/WebhookController.php:149
msgid "Signature verification failed. The webhook will keep being rejected until the gateway credentials and webhook id match this site."
msgstr "Die Signaturprüfung ist fehlgeschlagen. Der Webhook wird so lange abgelehnt, bis die Zugangsdaten des Zahlungsanbieters und die Webhook-ID zu dieser Website passen."

#: src/Rest/WebhookController.php:156
msgid "Webhook rejected."
msgstr "Webhook abgelehnt."

#: src/Settings/ReadinessService.php:142

#: src/Settings/SettingsService.php:274
#: assets/admin/settings/panels/ReceiptsPanel.jsx:168
msgid "Thank you for your support, {donor_name}."
msgstr "Vielen Dank für Ihre Unterstützung, {donor_name}."

#: src/Settings/SettingsService.php:275
msgid "This is a non-fiscal acknowledgement of receipt. Whether your donation is tax-deductible depends on your local jurisdiction and the recipient organization's status. Keep this receipt for your records."
msgstr "Dies ist eine Empfangsbestätigung, kein steuerlicher Beleg. Ob Ihre Spende steuerlich absetzbar ist, hängt von der Rechtslage an Ihrem Wohnsitz und vom Status der Empfängerorganisation ab. Bewahren Sie diese Quittung für Ihre Unterlagen auf."

#: src/Settings/SettingsService.php:296
msgid "Thank you for your donation to {organisation_name}"
msgstr "Vielen Dank für Ihre Spende an {organisation_name}"

#: src/Settings/SettingsService.php:297
msgid "Hi {donor_first_name},\n\nThank you for your donation of {amount} to {organisation_name}.\n\nReference: {reference}\nReceipt number: {receipt_number}\n\nYour receipt is attached as a PDF. Keep it for your records.\n\nWith gratitude,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nvielen Dank für Ihre Spende über {amount} an {organisation_name}.\n\nReferenz: {reference}\nQuittungsnummer: {receipt_number}\n\nIhre Quittung ist als PDF angehängt. Bewahren Sie sie für Ihre Unterlagen auf.\n\nMit herzlichem Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:301
msgid "Thank you for your first donation to {organisation_name}"
msgstr "Vielen Dank für Ihre erste Spende an {organisation_name}"

#: src/Settings/SettingsService.php:302
msgid "Hi {donor_first_name},\n\nThank you for making your first donation to {organisation_name}. Your support means a great deal, and we are grateful to have you with us.\n\nWe will keep you posted on the difference it makes.\n\nWith gratitude,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nvielen Dank für Ihre erste Spende an {organisation_name}. Ihre Unterstützung bedeutet uns sehr viel, und wir freuen uns, Sie an unserer Seite zu haben.\n\nWir halten Sie darüber auf dem Laufenden, was Ihre Spende bewirkt.\n\nMit herzlichem Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:306
msgid "Payment instructions for your donation to {organisation_name}"
msgstr "Zahlungshinweise für Ihre Spende an {organisation_name}"

#: src/Settings/SettingsService.php:307
msgid "Hi {donor_name},\n\nThank you for choosing to support {campaign_title} with a donation of {amount}.\n\n{instructions}\n\nPlease transfer the amount using the reference {reference}. We will email your receipt as soon as the payment arrives.\n\n{bank_details}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\ndanke, dass Sie {campaign_title} mit einer Spende über {amount} unterstützen möchten.\n\n{instructions}\n\nBitte überweisen Sie den Betrag und geben Sie dabei die Referenz {reference} an. Sobald die Zahlung eingegangen ist, senden wir Ihnen Ihre Quittung per E-Mail.\n\n{bank_details}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:311
msgid "Your donation is processing"
msgstr "Ihre Spende wird verarbeitet"

#: src/Settings/SettingsService.php:312
msgid "Hi {donor_first_name},\n\nWe have received your donation of {amount}.\n\nReference: {reference}\n\nYour payment is being processed. Bank settlement can take a few business days; we will email your receipt the moment it clears.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nwir haben Ihre Spende über {amount} erhalten.\n\nReferenz: {reference}\n\nIhre Zahlung wird gerade verarbeitet. Die Abwicklung durch die Bank kann einige Werktage dauern; sobald die Zahlung gutgeschrieben ist, senden wir Ihnen Ihre Quittung per E-Mail.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:316
msgid "Your donation has been refunded"
msgstr "Ihre Spende wurde erstattet"

#: src/Settings/SettingsService.php:317
msgid "Hi {donor_name},\n\nWe have refunded your donation of {amount} to {campaign_title}. Funds should return to your card within 5 to 10 business days.\n\nIf this was a mistake or you have any questions, just reply to this email.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nwir haben Ihre Spende über {amount} für {campaign_title} erstattet. Der Betrag sollte innerhalb von 5 bis 10 Werktagen wieder auf Ihrer Karte eingehen.\n\nFalls das ein Versehen war oder Sie Fragen haben, antworten Sie einfach auf diese E-Mail.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:325
msgid "Payment instructions for {organisation_name}"
msgstr "Zahlungshinweise für {organisation_name}"

#: src/Settings/SettingsService.php:326
msgid "Hi {donor_name},\n\nThank you. Your payment of {amount} is not complete yet.\n\n{instructions}\n\nPlease transfer the amount using the reference {reference}. We will confirm as soon as the payment arrives.\n\n{bank_details}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nherzlichen Dank. Ihre Zahlung über {amount} ist noch nicht abgeschlossen.\n\n{instructions}\n\nBitte überweisen Sie den Betrag und geben Sie dabei die Referenz {reference} an. Wir bestätigen den Eingang, sobald die Zahlung bei uns angekommen ist.\n\n{bank_details}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:330
msgid "Your payment is processing"
msgstr "Ihre Zahlung wird verarbeitet"

#: src/Settings/SettingsService.php:331
msgid "Hi {donor_first_name},\n\nWe have received your payment of {amount}.\n\nReference: {reference}\n\nYour payment is being processed. Bank settlement can take a few business days; we will confirm as soon as it clears.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nwir haben Ihre Zahlung über {amount} erhalten.\n\nReferenz: {reference}\n\nIhre Zahlung wird gerade verarbeitet. Die Abwicklung durch die Bank kann einige Werktage dauern; wir bestätigen den Eingang, sobald die Zahlung gutgeschrieben ist.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:335
msgid "Your payment has been refunded"
msgstr "Ihre Zahlung wurde erstattet"

#: src/Settings/SettingsService.php:336
msgid "Hi {donor_name},\n\nWe have refunded your payment of {amount}. Funds should return to your card within 5 to 10 business days.\n\nReference: {reference}\n\nIf this was a mistake or you have any questions, just reply to this email.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nwir haben Ihre Zahlung über {amount} erstattet. Der Betrag sollte innerhalb von 5 bis 10 Werktagen wieder auf Ihrer Karte eingehen.\n\nReferenz: {reference}\n\nFalls das ein Versehen war oder Sie Fragen haben, antworten Sie einfach auf diese E-Mail.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:340
msgid "Your recurring donation renewed"
msgstr "Ihre wiederkehrende Spende wurde ausgeführt"

#: src/Settings/SettingsService.php:341
msgid "Hi {donor_name},\n\nYour recurring donation of {amount} to {campaign_title} was renewed today.\n\nReference: {reference}\n\nThank you for your continued support.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nIhre wiederkehrende Spende über {amount} für {campaign_title} wurde heute ausgeführt.\n\nReferenz: {reference}\n\nWir danken Ihnen für Ihre anhaltende Unterstützung.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:345
msgid "Your donation couldn't be taken this month"
msgstr "Ihre Spende konnte diesen Monat nicht abgebucht werden"

#: src/Settings/SettingsService.php:346
msgid "Hi {donor_first_name},\n\nWe tried to collect your recurring donation of {amount} to {campaign_title} today and your bank declined it. This usually means a card has expired or been replaced.\n\nNothing has been charged and your donation is still set up. You can put that right here:\n{portal_url}\n\nIf you would rather stop the donation, that is completely fine, and you can do that from the same page.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nwir haben heute versucht, Ihre wiederkehrende Spende über {amount} für {campaign_title} abzubuchen, aber Ihre Bank hat die Zahlung abgelehnt. Meist bedeutet das, dass eine Karte abgelaufen ist oder ersetzt wurde.\n\nEs wurde nichts abgebucht, und Ihre Spende ist weiterhin eingerichtet. Hier können Sie das beheben:\n{portal_url}\n\nWenn Sie die Spende lieber beenden möchten, ist das völlig in Ordnung. Auch das können Sie auf derselben Seite tun.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:350
msgid "Your recurring donation has been cancelled"
msgstr "Ihre wiederkehrende Spende wurde gekündigt"

#: src/Settings/SettingsService.php:351
msgid "Hi {donor_name},\n\nYour recurring donation of {amount} to {campaign_title} has been cancelled. No further charges will be made.\n\nThank you for the donations you made along the way.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nIhre wiederkehrende Spende über {amount} für {campaign_title} wurde gekündigt. Es wird nichts mehr abgebucht.\n\nDanke für alle Spenden, die Sie bis hierhin geleistet haben.\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:358
msgid "Your recurring donation amount has changed"
msgstr "Der Betrag Ihrer wiederkehrenden Spende wurde geändert"

#: src/Settings/SettingsService.php:359
msgid "Hi {donor_first_name},\n\nYour recurring donation to {campaign_title} has been changed from {old_amount} to {amount}, starting with your next payment.\n\nIf that is not what you expected, you can change it back or stop the donation here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nIhre wiederkehrende Spende für {campaign_title} wurde von {old_amount} auf {amount} geändert, beginnend mit Ihrer nächsten Zahlung.\n\nFalls Sie das nicht erwartet haben, können Sie die Änderung hier rückgängig machen oder die Spende beenden:\n{portal_url}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:363
msgid "Your recurring donation schedule has changed"
msgstr "Der Rhythmus Ihrer wiederkehrenden Spende wurde geändert"

#: src/Settings/SettingsService.php:364
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} was taken {old_frequency}. It will now be taken {frequency}, starting with the payment after your current one.\n\nIf that is not what you expected, you can change it back or stop the donation here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nIhre wiederkehrende Spende über {amount} für {campaign_title} wurde bisher {old_frequency} abgebucht. Künftig wird sie {frequency} abgebucht, beginnend mit der Zahlung nach Ihrer aktuellen.\n\nFalls Sie das nicht erwartet haben, können Sie die Änderung hier rückgängig machen oder die Spende beenden:\n{portal_url}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:368
msgid "Your recurring donation is paused"
msgstr "Ihre wiederkehrende Spende ist pausiert"

#: src/Settings/SettingsService.php:369
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} has been paused. Nothing will be charged until it restarts on {resumes_at}.\n\nYou can restart it sooner, or stop it altogether, here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nIhre wiederkehrende Spende über {amount} für {campaign_title} wurde pausiert. Bis sie am {resumes_at} fortgesetzt wird, wird nichts abgebucht.\n\nHier können Sie sie früher fortsetzen oder ganz beenden:\n{portal_url}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:373
msgid "Your recurring donation has restarted"
msgstr "Ihre wiederkehrende Spende wurde fortgesetzt"

#: src/Settings/SettingsService.php:374
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} has restarted. Your next payment is due on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nIhre wiederkehrende Spende über {amount} für {campaign_title} wurde fortgesetzt. Ihre nächste Zahlung ist am {next_payment_at} fällig.\n\nHier können Sie sie jederzeit verwalten:\n{portal_url}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:378
msgid "Your next donation has been skipped"
msgstr "Ihre nächste Spende wird übersprungen"

#: src/Settings/SettingsService.php:379
msgid "Hi {donor_first_name},\n\nYour next recurring donation of {amount} to {campaign_title} has been skipped. Nothing will be charged this time, and the donation continues on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_first_name},\n\nIhre nächste wiederkehrende Spende über {amount} für {campaign_title} wird übersprungen. Dieses Mal wird nichts abgebucht, und die Spende läuft am {next_payment_at} weiter.\n\nHier können Sie sie jederzeit verwalten:\n{portal_url}\n\nVielen Dank\n{organisation_name}"

#: src/Settings/SettingsService.php:383
msgid "Your sign-in link for {organisation_name}"
msgstr "Ihr Anmeldelink für {organisation_name}"

#: src/Settings/SettingsService.php:384
msgid "Hi {donor_name},\n\nOpen your donor portal:\n{portal_url}\n\nThis link works for {link_expiry} and can only be used once. If you didn't request it, you can ignore this email.\n\nThanks,\n{organisation_name}"
msgstr "Hallo {donor_name},\n\nhier geht es zu Ihrem Spenderportal:\n{portal_url}\n\nDieser Link ist {link_expiry} gültig und kann nur einmal verwendet werden. Falls Sie ihn nicht angefordert haben, können Sie diese E-Mail ignorieren.\n\nVielen Dank\n{organisation_name}"

#. translators: %s: the entry as the admin typed it.

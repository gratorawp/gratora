# Copy to tests-e2e/.env (gitignored) or export in your shell.

# Base URL of the WP site under test (no trailing slash).
DONO_E2E_URL=http://dono.local

# Path on that site to a published WP page containing the
# [dono_donation_form slug="..."] shortcode for your test form.
DONO_E2E_FORM_PATH=/donate/

# Multi-step form (dono/steps wizard) for multi-step.spec.ts. Created by
# `wp dono e2e-seed` at /dono-e2e-wizard/; the spec skips when this is unset.
DONO_E2E_MULTI_STEP_FORM_PATH=/dono-e2e-wizard/

# Copy to tests-e2e/.env (gitignored) or export in your shell.

# Base URL of the WP site under test (no trailing slash).
# Every spec navigates by relative path, so this is the only place the host is
# named: nothing under specs/ hardcodes a URL or a port.
GRATORA_E2E_URL=http://gratora.local

# wp-admin login for the specs that need one. Defaults in AdminPage.ts match
# wp-env (admin/password); a Local site needs these set. `wp gratora e2e-seed`
# provisions the user below.
GRATORA_E2E_ADMIN_USER=gratora-e2e-admin
GRATORA_E2E_ADMIN_PASS=gratora-e2e-pass

# Path on that site to a published WP page containing the
# [gratora_donation_form slug="..."] shortcode for your test form.
GRATORA_E2E_FORM_PATH=/donate/

# Multi-step form (gratora/steps wizard) for multi-step.spec.ts. Created by
# `wp gratora e2e-seed` at /gratora-e2e-wizard/; the spec skips when this is unset.
GRATORA_E2E_MULTI_STEP_FORM_PATH=/gratora-e2e-wizard/

/.git
/.github
/.claude
/.gitignore
/.distignore
/.eslintrc.js
/.prettierrc.js

/node_modules
/tests

# The repository named in readme.txt answers Guideline 4 for build/, so the
# webpack input does not have to travel with its output. The three assets/
# directories absent from this list are enqueued straight from assets/ and
# never reach build/.
/package.json
/webpack.config.js
/assets/admin
/assets/_shared
/assets/donation-form
/assets/donor-portal

/phpunit*.xml
/phpunit*.xml.dist
/.phpunit.cache
composer.lock
/package-lock.json

/tests-e2e
/test-results
/playwright.config.ts
/playwright-report
/TESTING.md
/bin/install-wp-tests.sh

/.idea
/.vscode
/.wp-env.json
/.wp-env.override.json
/.npmrc

/README.md
/ROADMAP.md
/languages/README.md
/.wordpress-org
/CLAUDE.md
/qa
/graphify-out

/bin

/vendor/dompdf
/vendor/fundkit
/vendor/masterminds
/vendor/sabberworm
/vendor/phpunit
/vendor/bin

.DS_Store
Thumbs.db
*.zip
*.log
*.map

# Named per package, this list only ever covers the dependency that already
# bit us: the upload form refused this plugin twice, once for a shell script a
# vendored package brought in its own bin/. These two rules are by shape, so a
# new dependency's tooling never reaches a reviewer.
*.sh
tests
.phpunit.result.cache
.php-cs-fixer.cache
*.cache
*.dist

# A vendored package carries its own repository furniture, and the rebrand
# showed why naming the package is the wrong shape: these were listed under a
# vendor directory that no longer exists, so they silently started shipping
# again the moment it was renamed. By shape, so the next dependency is covered
# without anybody remembering to add it.
.github
.gitignore
.php-cs-fixer.php

/vendor/vendor-prefixed/fundkit/queryable/bin
/vendor/vendor-prefixed/fundkit/queryable/tests
/vendor/vendor-prefixed/fundkit/queryable/phpunit.xml
/vendor/vendor-prefixed/dompdf/dompdf/tests
/vendor/vendor-prefixed/dompdf/php-font-lib/tests
/vendor/vendor-prefixed/dompdf/php-svg-lib/tests
/vendor/vendor-prefixed/masterminds/html5/test
/vendor/vendor-prefixed/sabberworm/php-css-parser/tests
/vendor/vendor-prefixed/masterminds/html5/bin

/.cache

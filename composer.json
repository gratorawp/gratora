{
    "name": "giveflow/giveflow",
    "description": "Donation platform for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "GiveFlow"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "dompdf/dompdf": "^3.1",
        "sabberworm/php-css-parser": "^8.4",
        "woocommerce/action-scheduler": "^4.1",
        "giveflow/queryable": "^1.0"
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.27.2",
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GiveFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GiveFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@analyse",
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit",
        "test:integration": "phpunit --configuration phpunit-integration.xml.dist",
        "strauss": [
            "@php -d memory_limit=1G vendor/bin/strauss",
            "find vendor/vendor-prefixed -type d -name .git -exec rm -rf {} +",
            "node bin/fix-fontlib-prefix.mjs",
            "@php -r \"file_put_contents('vendor/composer/autoload_aliases.php', '<?php');\"",
            "@composer dump-autoload"
        ],
        "test:setup": "bash bin/install-wp-tests.sh",
        "strauss:auto": "@php -r \"if (!file_exists('vendor/bin/strauss')) { exit(0); } passthru(escapeshellarg(getenv('COMPOSER_BINARY')) . ' strauss', $c); exit($c);\"",
        "post-install-cmd": [
            "@strauss:auto"
        ],
        "post-update-cmd": [
            "@strauss:auto"
        ],
        "analyse": "phpstan analyse --memory-limit=3G"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor/vendor-prefixed",
            "namespace_prefix": "GiveFlow\\Vendor\\",
            "classmap_prefix": "GiveFlow_Vendor_",
            "constant_prefix": "GIVEFLOW_VENDOR_",
            "packages": [
                "dompdf/dompdf",
                "dompdf/php-font-lib",
                "dompdf/php-svg-lib",
                "masterminds/html5",
                "sabberworm/php-css-parser",
                "giveflow/queryable"
            ],
            "update_call_sites": false,
            "delete_vendor_packages": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github-giveflowdev:givefloworg/queryable.git"
        }
    ]
}

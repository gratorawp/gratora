<?xml version="1.0" encoding="UTF-8"?>
<!--
  The network-wide behaviour, which the single-site suite cannot reach: it
  boots WordPress with no network at all, so is_multisite() is false and every
  branch that matters here is skipped. Run with WP_MULTISITE=1.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/integration-bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.cache/test-results-multisite"
         failOnWarning="true"
         failOnRisky="true"
         processIsolation="false"
         convertDeprecationsToExceptions="false">

    <testsuites>
        <testsuite name="multisite">
            <directory>tests/Multisite</directory>
        </testsuite>
    </testsuites>
</phpunit>
